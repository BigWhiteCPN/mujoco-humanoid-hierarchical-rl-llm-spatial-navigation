# Natural-language commands use an OpenAI-compatible chat endpoint.
# Keep this file as an example only; put real secrets in .env.
SILICONFLOW_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/zai-org/GLM-4.7
LLM_TIMEOUT_SECONDS=60
DISABLE_LLM=false

ROBOT_MODEL_XML=resources/mjcf/Linnxil_fifteen_angle_bs_copy_20260302_copy.xml
LOW_LEVEL_POLICY_PATH=models/policy_20251026.pt
SAC_MODEL_PATH=models/sac_lidar_interrupted_good3_0.91.zip

RENDER_MODE=qt_dashboard
RENDER_DECIMATION=50
ACTION_REPEAT=4
HISTORY_LENGTH=15
IDLE_HZ=50
PERCEPTION_HZ=5
DASHBOARD_RENDER_HZ=15
MAX_CATCHUP_STEPS=1

ENABLE_DYNAMIC_OBSTACLES=false
ENABLE_MUJOCO_VIEWER=false
DEBUG_TIMING=false
SHOW_LANDMARK_DEBUG=false
MEMORY_DIR=memory_logs
MUJOCO_GL=egl
DEMO_CPU_THREADS=1
LOG_LEVEL=INFO
